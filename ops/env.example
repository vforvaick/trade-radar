# Telegram bot credentials used by bot.main and bot.main_multi
CRYPTOPASS_TG_TOKEN=your-telegram-bot-token
CRYPTOPASS_TG_CHAT=your-telegram-chat-id
# Optional: Telegram group for trade signal routing
# Trade signals + TP/SL alerts go to CRYPTOPASS_TG_GROUP_ID/TRADE_TOPIC; CRYPTOPASS_TG_CHAT is for command replies (DM) only
# Get these values by running: python scripts/get_telegram_ids.py
CRYPTOPASS_TG_GROUP_ID=                    # Optional: Telegram supergroup ID for trade signals
CRYPTOPASS_TG_TRADE_TOPIC_ID=              # Optional: Topic ID for trade signals
CRYPTOPASS_TG_LOG_TOPIC_ID=               # Optional: Topic ID for system logs (General)

# Telethon credentials used by scripts/fetch_samples.py and scripts/fetch_deep.py
CRYPTOPASS_TG_API_ID=123456
CRYPTOPASS_TG_API_HASH=your-telethon-api-hash
CRYPTOPASS_TG_SESSION=cryptopass_session

# Optional runtime settings
CRYPTOPASS_STATE_DB=/home/vforvaick/pumpradar-bot/state.db
CRYPTOPASS_BINANCE_VERIFY_TLS=true
