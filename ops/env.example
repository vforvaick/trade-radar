# Telegram bot credentials used by bot.main and bot.main_multi
PUMPRADAR_TG_TOKEN=your-telegram-bot-token
PUMPRADAR_TG_CHAT=your-telegram-chat-id

# Telethon credentials used by scripts/fetch_samples.py and scripts/fetch_deep.py
PUMPRADAR_TG_API_ID=123456
PUMPRADAR_TG_API_HASH=your-telethon-api-hash
PUMPRADAR_TG_SESSION=pumpradar_session

# Optional runtime settings
PUMPRADAR_STATE_DB=/home/vforvaick/pumpradar-bot/state.db
PUMPRADAR_BINANCE_VERIFY_TLS=true
